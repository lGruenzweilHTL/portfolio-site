# Copy to .env and fill in real values. .env is gitignored.

# --- OpenRouter (chatbot) ---
OPENROUTER_API_KEY=
# Comma-separated model ids, tried in order: when one is rate-limited, errors
# or replies empty, the next runs. Each model has its own rate-limit bucket,
# so every entry adds headroom. Once the list is used up, the rate-limited
# ones get one more try after a 2s backoff.
#
# Below: Gemini models via a Google AI Studio key added to OpenRouter as BYOK,
# ordered by tokens per minute on the AI Studio free tier (250K TPM first, then
# Gemma's 16K), ties broken by requests per day/minute, then strength. The
# Gemini ids have no :free variant: once the BYOK key is exhausted OpenRouter
# falls back to shared capacity and bills OpenRouter credits, unless the key
# is set to "never use shared capacity". Ids your account can't use fail over.
# See https://openrouter.ai/models for ids.
OPENROUTER_MODELS=google/gemini-3.5-flash-lite,google/gemini-3.1-flash-lite,google/gemini-2.5-flash-lite,google/gemini-3.8-flash,google/gemini-3.7-flash,google/gemini-3.6-flash,google/gemini-3.5-flash,google/gemini-3-flash-preview,google/gemini-2.5-flash,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
# Deprecated: single model, used only when OPENROUTER_MODELS is empty.
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Optional override for the OpenRouter base URL.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#
# Gemini API directly (no OpenRouter): the endpoint is OpenAI-compatible, so
# set the base URL and use an AI Studio key and Google's bare model ids
# (no "google/" prefix, no ":free"):
# OPENROUTER_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# OPENROUTER_API_KEY=<AI Studio key>
# OPENROUTER_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemma-4-31b-it,gemma-4-26b-a4b-it

# --- Chat limits ---
# Longest accepted user message in characters; longer ones are rejected with
# a "too long" message before anything is sent to the model.
CHAT_MAX_MESSAGE_CHARS=1000

# --- Cloudflare Turnstile (chatbot + feedback) ---
# sitekey goes in the frontend widget; secret stays server-side.
# In dev, set TURNSTILE_SITEKEY=1x00000000000000000000AA and
# TURNSTILE_SECRET=1x0000000000000000000000000000000AA to use Turnstile's
# documented "always passes" test keys (https://developers.cloudflare.com/turnstile/troubleshooting/testing/).
TURNSTILE_SITEKEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# In dev, set TURNSTILE_DEV_BYPASS=1 to skip siteverify entirely (logs a warning).
# NEVER set this in production.
TURNSTILE_DEV_BYPASS=1

# --- GitHub deploy webhook ---
# Generate with: openssl rand -hex 32
# In dev, leave blank to disable signature verification (with a warning).
DEPLOY_WEBHOOK_SECRET=
# systemd unit to restart on a successful deploy. Leave blank to skip.
DEPLOY_SYSTEMD_UNIT=backend
# Trigger file the deploy handler creates; the matching .path unit restarts
# the service as root. Must sit inside the group-writable directory that
# deploy/backend-restart.conf installs — /run itself is root-owned 0755, so
# the app process cannot create a file there directly.
DEPLOY_RESTART_FLAG=/run/backend-restart/trigger

# --- Cloudflare Access (admin gate) ---
# In prod, Cloudflare Access injects a verified-email header on /admin.
# Header name to trust: Cf-Access-Authenticated-User-Email
# In dev, set ADMIN_DEV_BYPASS=1 and ADMIN_DEV_USER to test without Access.
ADMIN_DEV_BYPASS=1
ADMIN_DEV_USER=lukas@local

# --- Database ---
# Path to the SQLite file. Created on first run. Gitignored.
DATABASE_PATH=./resume.db

# --- Site / content paths ---
SITE_DIR=./site
CONTENT_DIR=./content
TEMPLATES_DIR=./backend/templates
STATIC_GENERATED_DIR=./static/generated
FILES_DIR=./site/files
SECURE_FILES_DIR=./site/files/secure

# Public-facing base URL (no trailing slash). Used to build absolute share URLs
# in admin responses (e.g. secure link copies). In prod: https://lukasgruenzweil.com
BASE_URL=http://localhost:8000

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info

# --- Rate limits (per IP) ---
CHAT_RATE_LIMIT=10/minute
FEEDBACK_RATE_LIMIT=5/minute
TRACK_RATE_LIMIT=120/minute
DEPLOY_RATE_LIMIT=10/minute

# --- Live rack status (GET /api/status) ---
# Node count shown on the PDU readout (static; Proxmox is never queried).
HOMELAB_NODES=3
# Cache lifetime for per-project GitHub push dates. Unauthenticated GitHub
# allows 60 requests/hour per IP.
GITHUB_CACHE_SECONDS=3600

# --- ntfy notifications ---
# Set NTFY_ENABLED=1 to send. Off by default so dev never spams you.
# Triggers: feedback received (priority high), deploy success/fail (priority
# low on success, max on any FAILED step).
NTFY_ENABLED=0
NTFY_BASE_URL=https://ntfy.yourdomain.com     # no trailing slash
NTFY_TOPIC=portfolio                    # single topic
NTFY_AUTH_TOKEN=                                # optional Bearer token if your ntfy requires it
