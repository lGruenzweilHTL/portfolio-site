[Unit]
Description=Restart backend.service when the deploy webhook sets the restart flag
Documentation=man:systemd.service(5)

# Triggered by backend-restart.path when the trigger file appears.
# Runs as root (no User=), so it can call `systemctl restart backend`
# on behalf of the unprivileged app process that created the trigger.

[Service]
Type=oneshot
# Consume the trigger before the restart so the PathExists= condition goes
# unsatisfied and the next deploy produces a fresh edge. Without this, the
# trigger file would survive the restart and every later deploy would be
# dropped as "condition already satisfied".
ExecStartPre=/bin/rm -f /run/backend-restart/trigger
ExecStart=/bin/systemctl restart backend.service

# Deliberately NO RemainAfterExit=yes.
#
# It looks cosmetic, but it is the single thing that breaks this design: a
# oneshot with RemainAfterExit transitions to "active (exited)" and stays
# there forever. A .path unit's start request against an already-active unit
# is a no-op, so the mechanism can fire exactly once and never again. A plain
# oneshot returns to "inactive (dead)", which is what lets PathExists=
# retrigger it on the next deploy.
