[Unit]
Description=Watch the deploy restart trigger and restart backend.service
Documentation=man:systemd.path(5)

# Triggered by backend-restart.path when the trigger file appears.
# Runs as root (no User=), so it can call `systemctl restart backend`
# on behalf of the unprivileged app process that created the trigger.

[Path]
# Leading-edge trigger: fires when the deploy handler creates the file, which
# it can do because tmpfiles.d/backend-restart.conf makes the parent
# directory group-writable. backend-restart.service removes the trigger in
# ExecStartPre=, so the condition goes unsatisfied again and the next deploy
# re-arms it.
#
# PathChanged= would be wrong here: it also fires on the service's own
# `rm`, which would loop.
PathExists=/run/backend-restart/trigger
Unit=backend-restart.service

[Install]
WantedBy=multi-user.target
